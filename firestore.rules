
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User Profiles: Only the specific user can read or write their own profile.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Families: 
    // - Any authenticated user can create a family.
    // - Any member of the family (determined by user document) can read the family metadata.
    // - Only the creator can update the family name.
    match /families/{familyId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && (
        resource.data.creatorId == request.auth.uid || 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.familyId == familyId
      );
      allow update: if request.auth != null && resource.data.creatorId == request.auth.uid;
      allow delete: if false; // Families are permanent for ledger integrity.
    }
    
    // Transactions:
    // - Any authenticated user can create transactions.
    // - Read access is granted if the transaction belongs to the user OR their shared family.
    // - Update/Delete is EXCLUSIVELY granted to the creator (userId).
    match /transactions/{transactionId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid || 
        (resource.data.familyId != null && resource.data.familyId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.familyId)
      );
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Feedback: Allow any authenticated user to create feedback.
    match /feedback/{id} {
      allow create: if true; // Allow local users to send feedback too
      allow read, update, delete: if false; // Only accessible via Firebase Console for privacy
    }
  }
}
